# Configurable LangChain LLM provider (server-side only; never commit real keys)
# Supported providers: openai, groq, gemini, openai_compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Optional provider-specific keys (used if LLM_API_KEY is unset)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Optional custom OpenAI-compatible base URL (for example, local Ollama or proxy)
# LLM_BASE_URL=

# Optional timeouts and server settings
LLM_TIMEOUT_SECONDS=20
APP_RELOAD=false
PORT=8000
