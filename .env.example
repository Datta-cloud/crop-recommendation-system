# Configurable LangChain LLM provider (server-side only; never commit real keys)
# Leave LLM_PROVIDER blank to auto-detect from whichever API key is set,
# or set explicitly: gemini, openai, groq, openai_compatible
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=

# Provider-specific keys (recommended: set GEMINI_API_KEY on Render)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Optional 15-day weather API key (Visual Crossing free tier avoids Render shared-IP limits)
# Leave blank to use Open-Meteo without an API key
WEATHER_API_KEY=

# Optional custom OpenAI-compatible base URL (for example, local Ollama or proxy)
# LLM_BASE_URL=

# Optional timeouts and server settings
LLM_TIMEOUT_SECONDS=20
APP_RELOAD=false
PORT=8000
